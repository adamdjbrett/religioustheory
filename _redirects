# Netlify redirects configuration
# Redirects for changed URLs

# Redirect old WordPress image paths to new location
/wp-content/uploads/* /images/:splat 301

# Redirect old WordPress abstacts to docs
/abstracts/:filename /docs/:filename 301

# Catch-all patterns for common WordPress paths
/wp-admin/* / 301
/wp-login* / 301
/xmlrpc.php / 301

# Feed redirects (if needed for older subscriber links)
/feed/ /feed/feed.xml 301
/feed.xml /feed/feed.xml 301
/rss.xml /feed/feed.rss 301
